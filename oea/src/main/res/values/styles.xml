<resources>
    <style name="OeaTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#8AB4F8</item>
        <item name="android:navigationBarColor">#0C0F15</item>
        <item name="android:statusBarColor">#0C0F15</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- OEA Home: the real system wallpaper (static or live) is shown behind a
         fully transparent, edge-to-edge window, exactly like a native launcher. -->
    <style name="OeaHomeTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">#8AB4F8</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActivityTransitions">false</item>
        <!-- The Dynamic Island must be able to render INTO the display cutout
             region so its pill can wrap the front camera (punch hole) instead
             of hanging below it. shortEdges guarantees that in every
             orientation. Ignored on API < 27 devices, which have no cutouts
             this code needs to consider. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- OEA tool screens (Settings, Game Boost) draw edge-to-edge and pad
         themselves with the real system-bar insets. -->
    <style name="OeaPanelTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">#8AB4F8</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- OEA Themes app: OEA's panel look; on Android 12+ its splash carries the OEA brand. -->
    <style name="OeaBrandedPanelTheme" parent="OeaPanelTheme" />

    <!-- Immersive mini-apps (EMAGE, VIP, Camera): no title bar, edge to edge,
         the window draws behind the status and navigation bars. -->
    <style name="OeaFullscreenAppTheme" parent="OeaPanelTheme">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="OeaGameBoostTheme" parent="OeaPanelTheme">
        <item name="android:colorAccent">#57C8FF</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- Running games: black, no window background overdraw, edge to edge. -->
    <style name="OeaGameTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="OeaTranslucentTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Full-screen call screen: the real wallpaper behind a readable scrim. -->
    <style name="OeaInCallTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">#8AB4F8</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Popup and floating-card call screens: translucent, so the app underneath stays visible. -->
    <style name="OeaInCallPopupTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">#8AB4F8</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="OeaCaptureTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:colorAccent">#8AB4F8</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
