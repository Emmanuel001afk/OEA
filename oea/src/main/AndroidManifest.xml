<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Phone: incoming-call screen over the lock screen / other apps, and the
         proximity sensor that turns the screen off near the ear. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Launcher essentials: apply wallpapers, pull down the notification shade
         from a Home gesture, and open Android's uninstall confirmation. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application
        android:name=".OeaApplication"
        android:resizeableActivity="true"
        android:icon="@mipmap/ic_oea_launcher"
        android:roundIcon="@mipmap/ic_oea_launcher"
        android:theme="@style/OeaTheme"
        android:label="OEA Launcher"
        android:allowBackup="false"
        android:supportsRtl="true">
        <!-- OEA Home: the default-launcher activity. It stays out of Recents,
             survives configuration changes without recreation and keeps the
             wallpaper visible behind a transparent, edge-to-edge window. -->
        <activity
            android:name=".OeaLauncherActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:resumeWhilePausing="true"
            android:resizeableActivity="true"
            android:screenOrientation="nosensor"
            android:windowSoftInputMode="adjustNothing|stateAlwaysHidden"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:theme="@style/OeaHomeTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- OEA Settings: its own task, reachable from Home and as an app. -->
        <activity
            android:name=".OeaSystemToolsActivity"
            android:exported="false"
            android:label="OEA Settings"
            android:taskAffinity="com.oea.launcher.settings"
            android:theme="@style/OeaPanelTheme"
            android:windowSoftInputMode="adjustResize" />
        <activity-alias
            android:name=".OeaSettingsAlias"
            android:exported="true"
            android:label="OEA Settings"
            android:icon="@drawable/ic_oea_settings"
            android:roundIcon="@drawable/ic_oea_settings"
            android:targetActivity=".OeaSystemToolsActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <!-- Game Boost: a standalone app with its own icon and task, usable even
             when OEA is not the default launcher. -->
        <activity
            android:name="com.oea.launcher.gameboost.OeaGameBoostActivity"
            android:exported="true"
            android:label="Game Boost"
            android:icon="@drawable/ic_oea_game_boost"
            android:roundIcon="@drawable/ic_oea_game_boost"
            android:taskAffinity="com.oea.launcher.gameboost"
            android:launchMode="singleTask"
            android:theme="@style/OeaGameBoostTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Freezer: a standalone app with its own icon and task, like Game Boost,
             Phone and Call Blocker, so it can be opened and placed on Home. -->
        <activity
            android:name="com.oea.launcher.freezer.OeaFreezerActivity"
            android:exported="true"
            android:label="Freezer"
            android:icon="@drawable/ic_oea_freezer"
            android:roundIcon="@drawable/ic_oea_freezer"
            android:taskAffinity="com.oea.launcher.freezer"
            android:launchMode="singleTask"
            android:theme="@style/OeaPanelTheme"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- OEA Games: the hub for games built on the OEA Game Engine. Its own
             task (like Game Boost), so a running game resumes from the icon or
             the Dynamic Island. Not singleTask: that would close a running game. -->
        <activity
            android:name="com.oea.launcher.games.OeaGamesActivity"
            android:exported="true"
            android:label="OEA Games"
            android:icon="@drawable/ic_oea_games"
            android:roundIcon="@drawable/ic_oea_games"
            android:taskAffinity="com.oea.launcher.games"
            android:theme="@style/OeaGameBoostTheme"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- A running game (OpenGL ES 3). Handles rotation itself, so switching a
             game to landscape never restarts it. -->
        <activity
            android:name="com.oea.launcher.games.OeaGameActivity"
            android:exported="false"
            android:label="OEA Games"
            android:taskAffinity="com.oea.launcher.games"
            android:launchMode="singleTop"
            android:theme="@style/OeaGameTheme"
            android:screenOrientation="unspecified"
            android:hardwareAccelerated="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density" />
        <!-- "Add to Home screen" requests (pinned shortcuts and widgets). -->
        <activity
            android:name=".OeaPinRequestActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:autoRemoveFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/OeaTranslucentTheme">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_APPWIDGET" />
            </intent-filter>
        </activity>
        <!-- OEA Assistant: accessibility service for lock, notifications,
             Recents, split screen and the no-root App Freezer. -->
        <service
            android:name="com.oea.launcher.assistant.OeaAssistantService"
            android:exported="true"
            android:label="@string/oea_assistant_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/oea_assistant" />
        </service>
        <activity
            android:name="com.oea.launcher.phone.OeaPhoneActivity"
            android:exported="true"
            android:label="Phone"
            android:icon="@drawable/ic_oea_phone"
            android:roundIcon="@drawable/ic_oea_phone"
            android:taskAffinity="com.oea.launcher.phone"
            android:theme="@style/OeaTheme">
            <!-- The no-data DIAL filter is required for Android's default-dialer
                 role resolver; the tel filter handles links and prefilled numbers. -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
            <!-- Expose Phone as a normal launchable app, not only a system-tools row. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.CALL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>
        <!-- Call screens. Full screen shows the wallpaper behind a dark scrim;
             popup and floating card use a translucent activity so the app
             underneath stays visible and usable. -->
        <activity
            android:name="com.oea.launcher.phone.OeaInCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity="com.oea.launcher.incall"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/OeaInCallTheme" />
        <activity
            android:name="com.oea.launcher.phone.OeaInCallPopupActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity="com.oea.launcher.incall"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/OeaInCallPopupTheme" />
        <receiver
            android:name="com.oea.launcher.phone.OeaCallActionReceiver"
            android:exported="false" />
        <service
            android:name="com.oea.launcher.phone.OeaInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <!-- false: Telecom plays the ringtone and vibration (respecting ringer
                 mode and Do Not Disturb). "true" told Android that OEA rings
                 itself, which left incoming calls silent. -->
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_RINGING"
                android:value="false" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>
        <receiver
            android:name="com.oea.launcher.applock.OeaDeviceAdminReceiver"
            android:exported="true"
            android:label="OEA App Freezer">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/oea_device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
        <activity
            android:name="com.oea.launcher.callblocker.OeaCallBlockerActivity"
            android:exported="true"
            android:label="Call Blocker"
            android:icon="@drawable/ic_oea_call_blocker"
            android:roundIcon="@drawable/ic_oea_call_blocker"
            android:taskAffinity="com.oea.launcher.callblocker"
            android:theme="@style/OeaTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name="com.oea.launcher.callblocker.OeaCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>
        <service
            android:name=".notifications.OeaNotificationListener"
            android:exported="true"
            android:label="OEA Notification access"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <service
            android:name=".workspace.OeaDynamicIslandOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows the user's explicitly enabled OEA live-activity island over other apps." />
        </service>
        <activity
            android:name="com.oea.launcher.gameboost.OeaGameCaptureActivity"
            android:exported="false"
            android:theme="@style/OeaCaptureTheme"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:launchMode="singleTop" />
        <service
            android:name="com.oea.launcher.gameboost.OeaGameCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <service
            android:name="com.oea.launcher.gameboost.OeaGameBoostService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Monitors selected games and provides OEA game-session controls." />
        </service>
    </application>
</manifest>