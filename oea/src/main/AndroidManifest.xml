<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application
        android:name=".OeaApplication"
        android:icon="@drawable/oea_logo"
        android:roundIcon="@drawable/oea_logo"
        android:theme="@style/OeaTheme"
        android:label="OEA Launcher"
        android:allowBackup="false"
        android:supportsRtl="true">
        <activity
            android:name=".OeaLauncherActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".OeaSystemToolsActivity"
            android:exported="false" />
        <activity-alias android:name=".OeaSettings" android:targetActivity=".OeaSystemToolsActivity" android:exported="true" android:label="OEA Additional Settings" android:icon="@drawable/oea_logo">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.PREFERENCE" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".OeaAppFreezer" android:targetActivity=".OeaSystemToolsActivity" android:exported="true" android:label="App Freezer" android:icon="@drawable/oea_logo">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".OeaCallBlocker" android:targetActivity=".OeaSystemToolsActivity" android:exported="true" android:label="Call Blocker" android:icon="@drawable/oea_logo">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".OeaGameBoost" android:targetActivity=".OeaSystemToolsActivity" android:exported="true" android:label="Game Boost" android:icon="@drawable/oea_logo">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".OeaMultitask" android:targetActivity=".OeaSystemToolsActivity" android:exported="true" android:label="Multitask &amp; Split Screen" android:icon="@drawable/oea_logo">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <receiver
            android:name="com.oea.launcher.applock.OeaDeviceAdminReceiver"
            android:exported="true"
            android:label="OEA App Freezer">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/oea_device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
        <service
            android:name="com.oea.launcher.callblocker.OeaCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>
        <service
            android:name=".notifications.OeaNotificationListener"
            android:exported="true"
            android:label="OEA Notification access"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <service
            android:name="com.oea.launcher.gameboost.OeaGameBoostService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Monitors selected games and provides OEA game-session controls." />
        </service>
    </application>
</manifest>