{
  "name": "oea-desktop",
  "productName": "OEA Desktop",
  "version": "0.1.0",
  "description": "A native desktop app launcher inspired by OEA.",
  "author": "OEA Project",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "overrides": {
    "minimatch@^10.2.5": "^11.0.1",
    "@electron/universal": {
      "minimatch@^9.0.3": "^11.0.1"
    }
  },
  "build": {
    "appId": "com.oea.desktop",
    "productName": "OEA Desktop",
    "directories": {
      "output": "../dist/desktop-installer"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "resources/oea.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "artifactName": "OEA-Desktop-${arch}-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OEA Desktop"
    },
    "portable": {
      "artifactName": "OEA-Desktop-Portable-${arch}-${version}.${ext}"
    }
  }
}
